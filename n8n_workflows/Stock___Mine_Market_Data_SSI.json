        620
      ]
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\n// Extract headers from the first item\nconst headers = items[0].json.row;\n\n// Map remaining rows directly into ClickHouse table schema\nreturn items.slice(1).map(item => {\n  const rowData = item.json.row;\n  \n  // Create key-value object from headers and row data\n  const rawData = {};\n  headers.forEach((header, index) => {\n    rawData[header] = rowData[index];\n  });\n\n  return {\n    json: {\n      symbol: String(rawData[\"CK\"] || \"\"),\n      open: (parseFloat(rawData[\"Mở cửa\"]) / 1000) || 0.0,\n      high: (parseFloat(rawData[\"Cao\"]) / 1000) || 0.0,\n      low: (parseFloat(rawData[\"Thấp\"]) / 1000)|| 0.0,\n      close: (parseFloat(rawData[\"Giá\"]) / 1000) || 0.0,\n      adj_close: (parseFloat(rawData[\"Giá\"]) / 1000) || 0.0,\n      volume: parseInt(rawData[\"Tổng KL\"], 10) || 0,\n      trading_value: (parseFloat(rawData[\"Tổng GT\"]) / 1000000) || 0.0,\n    }\n  };\n});"
      },
