      "parameters": {
        "jsCode": "// Define the temporal span parameter in months\nconst monthInterval = 3;\nconst currentDate = new Date();\n\n// Determine the initial boundary corresponding to the first day of the current month\nconst periodStartDate = new Date(currentDate.getFullYear(), currentDate.getMonth(), 1);\n\n// Determine the terminal boundary corresponding to the last day of the calculated end month\nconst periodEndDate = new Date(currentDate.getFullYear(), currentDate.getMonth() + monthInterval, 0);\n\n// Serialize date object to ISO standard string representation (YYYY-MM-DD)\nconst formatDateToString = (dateInstance) => dateInstance.toISOString().split('T')[0];\n\n// Construct the structured JSON output for the n8n node execution pipeline\nreturn [{\n    json: {\n        start_date: formatDateToString(periodStartDate),\n        end_date: formatDateToString(periodEndDate)\n    }\n}];"
