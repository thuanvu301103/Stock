    {
      "parameters": {
        "jsCode": "const results = [];\n\nconst timeRange = $input.all()[0].json;\nconst startDate = new Date(timeRange['start_date']);\nconst endDate = new Date(timeRange['end_date']); // Fixed typo in key name 'end _date'\n\n// Set time to 00:00:00 to avoid daylight saving time offset issues\nstartDate.setHours(0, 0, 0, 0);\nendDate.setHours(0, 0, 0, 0);\n\nconst currentDate = new Date(startDate);\n\nwhile (currentDate <= endDate) {\n  const year = currentDate.getFullYear();\n  const month = currentDate.getMonth() + 1;\n  const dayOfWeek = currentDate.getDay() === 0 ? 7 : currentDate.getDay(); // Monday=1, Sunday=7\n  const quarter = Math.floor((month - 1) / 3) + 1;\n\n  const isWeekend = dayOfWeek === 6 || dayOfWeek === 7 ? 1 : 0;\n\n  // Format YYYY-MM-DD using local time\n  const dayStr = String(currentDate.getDate()).padStart(2, '0');\n  const monthStr = String(month).padStart(2, '0');\n  const dateKey = `${year}-${monthStr}-${dayStr}`;\n\n  results.push({\n    date_key: dateKey,\n    year,\n    quarter,\n    month,\n    day_of_week: dayOfWeek,\n    is_weekend: isWeekend,\n    is_trading_day: isWeekend ? 0 : 1\n  });\n\n  // Increment by 1 day\n  currentDate.setDate(currentDate.getDate() + 1);\n}\n\nreturn results.map(r => ({ json: r }));"
      },
