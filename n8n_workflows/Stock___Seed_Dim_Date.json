    {
      "parameters": {
        "jsCode": "const days = 120;\nconst results = [];\n\nconst today = new Date();\n\nfor (let i = 0; i < days; i++) {\n  const d = new Date(today);\n  d.setDate(today.getDate() - i);\n\n  const year = d.getFullYear();\n  const month = d.getMonth() + 1;\n  const dayOfWeek = d.getDay() === 0 ? 7 : d.getDay(); // Monday=1\n  const quarter = Math.floor((month - 1) / 3) + 1;\n\n  const isWeekend = dayOfWeek === 6 || dayOfWeek === 7 ? 1 : 0;\n\n  results.push({\n    date_key: d.toISOString().slice(0, 10),\n    year,\n    quarter,\n    month,\n    day_of_week: dayOfWeek,\n    is_weekend: isWeekend,\n    is_trading_day: isWeekend ? 0 : 1\n  });\n}\n\nreturn results.map(r => ({ json: r }));"
      },
      "id": "f645a0ec-27d7-488d-84c5-47b076af3697",
      "name": "Generate dim_date rows",
      "type": "n8n-nodes-base.code",
