        "jsCode": "const items = $input.first().json.data;\nconst uniqueStockKeys = [...new Set(items.map(item => item.stock_key))];\nconst resultString = uniqueStockKeys.join(',');\n\nreturn [\n  {\n    json: {\n      stock_keys_string: resultString\n    }\n  }\n];"
