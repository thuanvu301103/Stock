    {
      "parameters": {
        "jsCode": "/**\n * Data Processing Node for Equity Portfolio Analysis\n * Extracts total stock value (stock_balance), stock list items, and key metrics (symbol, quantity, costPrice).\n */\n\n// Retrieve input items from n8n execution context\nconst inputItems = $input.all();\n\nconst processedOutput = inputItems.map(item => {\n  // Access the nested equity array from the input payload\n  const rawData = item.json;\n  \n  // Handle array or direct object structures safely\n  const equityData = Array.isArray(rawData) ? rawData : [rawData];\n  \n  let totalStockBalanceValue = 0;\n  let totalStockQuantity = 0;\n  let stockList = [];\n\n  equityData.forEach(entry => {\n    if (entry.equity && Array.isArray(entry.equity)) {\n      entry.equity.forEach(holding => {\n        const quantity = parseFloat(holding.quantity) || 0;\n        const costPrice = parseFloat(holding.costPrice) || 0;\n\n        // Calculate total monetary value for the current holding (quantity * costPrice)\n        const holdingValue = quantity * costPrice;\n\n        // Accumulate total portfolio stock balance (total monetary value)\n        totalStockBalanceValue += holdingValue;\n        \n        // Track total physical share count separately if needed\n        totalStockQuantity += quantity;\n\n        // Map required fields for the stock list items\n        stockList.push({\n          symbol: holding.symbol,\n          quantity: quantity,\n          costPrice: costPrice,\n          holding_value: holdingValue,\n          accountNo: holding.accountNo,\n          sellableQuantity: parseFloat(holding.sellableQuantity) || 0\n        });\n      });\n    }\n  });\n\n  return {\n    json: {\n      stock_balance: totalStockBalanceValue,\n      total_share_quantity: totalStockQuantity,\n      stock_list: stockList,\n      total_symbols: stockList.length,\n      timestamp: Date.now()\n    }\n  };\n});\n\nreturn processedOutput;"
      },
      "id": "72631f72-a619-472d-9290-f36cdae2b423",
      "name": "Code",
      "type": "n8n-nodes-base.code",
