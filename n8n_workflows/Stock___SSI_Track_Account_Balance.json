    {
      "parameters": {
        "jsCode": "/**\n * Data Processing Node for Portfolio Asset Allocation\n * Calculates total_balance, w_cash, w_stock, and overrides stock_balance to represent total stock value.\n */\n\nconst inputItems = $input.all();\n\nconst processedOutput = inputItems.map(item => {\n  const data = item.json;\n  \n  // Parse cash balance safely\n  const cashBalance = parseFloat(data.cash_balance) || 0;\n  \n  // Calculate total stock value based on quantity and costPrice\n  let totalStockValue = 0;\n  if (Array.isArray(data.stock_list)) {\n    totalStockValue = data.stock_list.reduce((acc, stock) => {\n      const qty = parseFloat(stock.quantity) || 0;\n      const price = parseFloat(stock.costPrice) || 0;\n      return acc + (qty * price);\n    }, 0);\n  }\n\n  // Calculate total portfolio balance (stock value + cash balance)\n  const totalBalance = cashBalance + totalStockValue;\n\n  // Calculate allocation percentages rounded to 2 decimal places\n  const wCash = totalBalance > 0 ? Number(((cashBalance / totalBalance) * 100).toFixed(2)) : 0;\n  const wStock = totalBalance > 0 ? Number(((totalStockValue / totalBalance) * 100).toFixed(2)) : 0;\n\n  return {\n    json: {\n      ...data,\n      stock_balance: totalStockValue,\n      stock_value: totalStockValue,\n      total_balance: totalBalance,\n      w_cash: wCash,\n      w_stock: wStock\n    }\n  };\n});\n\nreturn processedOutput;"
      },
