      "id": "fbe556c3-06d2-43b1-83bc-f92502804cce",
      "name": "Get VN30 Stocks2",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        5500,
        1780
      ]
    },
    {
      "parameters": {
        "jsCode": "// Process all incoming items from the n8n workflow execution\nreturn $input.all().map(item => {\n  const rawData = item.json.data || '';\n\n  // Separate the string by newline characters, remove whitespace, and filter empty lines\n  const stockSymbols = rawData\n    .split(/\\r?\\n/)\n    .map(symbol => symbol.trim())\n    .filter(symbol => symbol.length > 0);\n\n  // Return the structured output containing the array of symbols\n  return {\n    json: {\n      vn30_stock_symbols: stockSymbols\n    }\n  };\n});"
      },
      "id": "2e04ce5e-d58b-4f27-986f-814f60f18e9f",
      "name": "Process VN30 Stock",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        5700,
        1780
      ]
    },
    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "multiplex",
        "options": {}
      },
      "id": "ad4ea56b-fd22-44dc-abd9-34011f7e713f",
      "name": "Merge1",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 2.1,
      "position": [
        5920,
        1700
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map(item => {\n  const data = item.json;\n  const stockList = data.stock_list || [];\n  const vn30Symbols = new Set(data.vn30_stock_symbols || []);\n  \n  const stockValue = data.stock_value || stockList.reduce((sum, stock) => sum + (stock.holding_value || 0), 0);\n\n  let vn30TotalValue = 0;\n  let nonVn30TotalValue = 0;\n\n  stockList.forEach(stock => {\n    const holdingValue = stock.holding_value || 0;\n    if (vn30Symbols.has(stock.symbol)) {\n      vn30TotalValue += holdingValue;\n    } else {\n      nonVn30TotalValue += holdingValue;\n    }\n  });\n\n  const w_larg_cap = stockValue > 0 ? Number(((vn30TotalValue / stockValue) * 100).toFixed(2)) : 0;\n  const w_mid_cap = stockValue > 0 ? Number(((nonVn30TotalValue / stockValue) * 100).toFixed(2)) : 0;\n\n  return {\n    json: {\n      ...data,\n      w_larg_cap: w_larg_cap,\n      w_mid_cap: w_mid_cap,\n      vn30_holding_value: vn30TotalValue,\n      non_vn30_holding_value: nonVn30TotalValue\n    }\n  };\n});"
      },
