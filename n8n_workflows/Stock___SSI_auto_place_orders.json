    {
      "parameters": {
        "jsCode": "// Retrieve data from the previous node\nconst inputData = $input.first().json;\n\n// Extract the result array containing stock details\nconst results = inputData.result || [];\n\n// Transform each stock entry into the required order payload structure\nconst orders = results\n    .map(item => {\n        return {\n            symbol: item.symbol,\n            quantity: Math.round(item.suggested_shares),\n            price: String(Number((item.pivot_s1_plus_1).toFixed(1)*1000))\n        };\n    })\n    .filter(order => order.quantity !== 0);\n\n// Return the formatted output payload containing the orders array\nreturn [{\n    json: {\n        body: {\n          access_token: inputData.accessToken,\n          orders: orders\n        }\n    }\n}];"
      },
