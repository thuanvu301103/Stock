    {
      "parameters": {
        "jsCode": "const inputData = $input.first().json;\nconst items = inputData.exchangeIndicesData.data;\n\n// Validate that the data property contains an array\nif (!Array.isArray(items)) {\n    return [];\n}\n\n// Map rows directly into the ClickHouse table schema matching API response\nreturn items.map(item => {\n    return {\n        json: {\n            index_id: String(item.indexId || \"\"),\n            exchange: String(item.exchange || \"\"),\n            index_value: parseFloat(item.indexValue) || 0.0,\n            change: parseFloat(item.change) || 0.0,\n            change_percent: parseFloat(item.changePercent) || 0.0,\n            chart_open: parseFloat(item.chartOpen) || 0.0,\n            chart_high: parseFloat(item.chartHigh) || 0.0,\n            chart_low: parseFloat(item.chartLow) || 0.0,\n            advances: parseInt(item.advances, 10) || 0,\n            declines: parseInt(item.declines, 10) || 0,\n            nochanges: parseInt(item.nochanges, 10) || 0,\n            ceiling: parseInt(item.ceiling, 10) || 0,\n            floor: parseInt(item.floor, 10) || 0,\n            total_qtty: parseInt(item.totalQtty, 10) || 0,\n            total_qtty_pt: parseInt(item.totalQttyPT, 10) || 0,\n            total_value: parseFloat(item.totalValue) || 0.0,\n            total_value_pt: parseFloat(item.totalValuePT) || 0.0,\n            all_qty: parseInt(item.allQty, 10) || 0,\n            all_value: parseFloat(item.allValue) || 0.0\n        }\n    };\n});"
      },
