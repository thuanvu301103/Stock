        "operation": "executeQuery",
        "query": "=SELECT * FROM order_items\nWHERE account_id = '{{ $env.SSI_ACCOUNT_NO }}'\nAND trade_type = 'BUY'\nAND trade_date = (\n      SELECT MAX(trade_date)\n      FROM order_items\n      WHERE account_id = '{{ $env.SSI_ACCOUNT_NO }}'\n        AND trade_type = 'BUY'\n  )",
        "options": {}
