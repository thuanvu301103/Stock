    {
      "parameters": {
        "jsCode": "function generateUUIDv4() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n}\n\nif (!global.__n8n_device_id) {\n  global.__n8n_device_id = generateUUIDv4();\n}\n\nconst currentDeviceId = global.__n8n_device_id;\n\nreturn items.map(item => {\n  return {\n    json: {\n      orders: item.json.body.orders,\n      deviceId: currentDeviceId\n    }\n  };\n});"
      },
      "id": "0a33109f-e1ad-4fbf-aa97-8373f1d7b198",
      "name": "Generate Device Id",
      "type": "n8n-nodes-base.code",
