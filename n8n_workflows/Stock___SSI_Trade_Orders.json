      "id": "a311e496-152c-44a0-b772-0840b144a256",
      "name": "Set Account No",
      "type": "n8n-nodes-base.set",
      "typeVersion": 2,
      "position": [
        2020,
        1000
      ]
    },
    {
      "parameters": {
        "jsCode": "// Retrieve data from the single input item\nconst inputData = items[0].json;\nconst orders = inputData.orders || [];\nconst deviceId = inputData.deviceId;\nconst accountNo = inputData.accountNo;\n\nconst newBuyOrders = [];\n\n// Iterate through the orders array and append contextual metadata\nfor (const order of orders) {\n  newBuyOrders.push({\n    ...order,\n    side: order.side || \"B\",\n    orderType: \"ATC\",\n    deviceId: deviceId,\n    accountNo: accountNo\n  });\n}\n\nreturn [{\n  json: {\n    orders: newBuyOrders\n  }\n}];"
      },
      "id": "496624cf-9934-45c4-a3b4-258835378792",
      "name": "Format Orders",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        2220,
        1000
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.ssi.com.vn/api/v3/trading/order/batch",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $json.accessToken }}"
            },
            {
              "name": "X-Signature",
              "value": "={{ $json.signature }}"
            }
          ]
        },
        "sendBody": true,
        "contentType": "raw",
        "rawContentType": "application/json",
        "body": "={{ $json.bodyString }}",
        "options": {}
      },
      "id": "c0c7d18c-0585-4055-878d-32791a73d3a0",
      "name": "Place Orders",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4,
      "position": [
        3180,
        1140
      ]
    },
    {
      "parameters": {
        "jsCode": "const currentItem = items[0].json;\n\nconst formatOrdersNodes = $('Format Orders').all();\nconst ordersData = formatOrdersNodes.length > 0 ? formatOrdersNodes[0].json.orders : [];\n\nreturn [{\n  json: {\n    ...currentItem,\n    orders: ordersData\n  }\n}];"
      },
      "id": "c5d9e4fe-2c39-4cf8-9e90-6b895735cb85",
      "name": "No-op",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        2580,
        1140
      ]
    },
    {
      "parameters": {
        "jsCode": "const inputData = items[0].json;\nconst orders = inputData.orders || [];\n\nconst batchRequestTime = Date.now();\n\nfunction generateUUID() {\n  return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {\n    var r = Math.random() * 16 | 0, v = c == 'x' ? r : (r & 0x3 | 0x8);\n    return v.toString(16);\n  });\n}\n\nconst today = new Date().toISOString().slice(0, 10).replace(/-/g, '');\nconst batchRequestId = `BUY_${today}_${generateUUID()}`;\n\nconst payload = {\n  batchRequestId: batchRequestId,\n  batchRequestTime: batchRequestTime,\n  orders: orders\n};\n\nreturn [{ \n  json: {\n    body: payload,\n    accessToken: inputData.accessToken\n  }\n}];"
      },
      "id": "5951c939-0e2a-4155-9a3c-951fbbbf0ef6",
      "name": "Replay prevent & Idempotency",
      "type": "n8n-nodes-base.code",
      "typeVersion": 1,
      "position": [
        2780,
        1140
      ]
    },
    {
      "parameters": {
        "jsCode": "const crypto = require('crypto');\n\nconst inputData = items[0].json.body;\nconst accessToken = items[0].json.accessToken;\n\nconst secret = $env.SSI_API_SECRET;\nconst rawKey = ($env.SSI_PRIVATE_KEY || '').trim();\nif (!secret || !rawKey) {\n  throw new Error('Missing env SSI_API_SECRET or SSI_PRIVATE_KEY');\n}\n\n// Accepts PEM (\"-----BEGIN ...\", \\n allowed) or the base64-encoded <RSAKeyValue> XML from the SSI portal\nfunction loadPrivateKey(raw) {\n  if (raw.includes('BEGIN')) {\n    return crypto.createPrivateKey(raw.replace(/\\\\n/g, '\\n'));\n  }\n  const xml = Buffer.from(raw, 'base64').toString('utf8');\n  const get = (tag) => {\n    const m = xml.match(new RegExp('<' + tag + '>([^<]+)</' + tag + '>'));\n    if (!m) throw new Error('RSAKeyValue is missing <' + tag + '>');\n    return Buffer.from(m[1], 'base64').toString('base64url');\n  };\n  return crypto.createPrivateKey({\n    key: {\n      kty: 'RSA',\n      n: get('Modulus'), e: get('Exponent'), d: get('D'),\n      p: get('P'), q: get('Q'), dp: get('DP'), dq: get('DQ'), qi: get('InverseQ'),\n    },\n    format: 'jwk',\n  });\n}\n\n// The exact string signed is the exact string sent (Place Orders sends bodyString as raw body).\nconst bodyString = JSON.stringify(inputData);\n\n// SSI spec: X-Signature = RSA-SHA256( SecretKey + JSON body ), base64\nconst sign = crypto.createSign('RSA-SHA256');\nsign.update(bodyString);\nsign.end();\nconst signature = sign.sign(loadPrivateKey(rawKey), 'hex');\n\nreturn [{ json: { accessToken, bodyString, signature } }];\n"
      },
