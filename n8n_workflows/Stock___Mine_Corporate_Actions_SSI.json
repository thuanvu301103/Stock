    {
      "parameters": {
        "jsCode": "const items = $input.all();\n\n// Extract headers from the first item\nconst rawHeaders = items[0].json.row || items[0].json;\n\n// Helper function to clean strings (removes line breaks, carriage returns, and extra spaces)\nfunction cleanString(str) {\n  if (!str) return \"\";\n  return String(str).replace(/[\\r\\n]+/g, \" \").replace(/\\s+/g, \" \").trim();\n}\n\n// Normalize all header strings\nconst headers = rawHeaders.map(header => cleanString(header));\n\n// Helper function to reformat 'DD/MM/YYYY' into 'YYYY-MM-DD' for ClickHouse\nfunction formatDate(dateStr) {\n  if (!dateStr) return null;\n  const cleanedStr = cleanString(dateStr);\n  const parts = cleanedStr.split(\"/\");\n  if (parts.length !== 3) return null;\n  const [day, month, year] = parts;\n  return `${year}-${month.padStart(2, \"0\")}-${day.padStart(2, \"0\")}`;\n}\n\n// Map remaining data rows directly into ClickHouse schema\nreturn items.slice(1).map(item => {\n  const rowData = item.json.row || item.json;\n  \n  // Build key-value map from headers and row values\n  const rawData = {};\n  headers.forEach((header, index) => {\n    rawData[header] = rowData[index];\n  });\n\n  return {\n    json: {\n      symbol: cleanString(rawData[\"Mã (Stock)\"]),\n      event_type: cleanString(rawData[\"Loại sự kiện (Event)\"]),\n      description: cleanString(rawData[\"Nội dung (Description)\"]),\n      ex_rights_date: formatDate(rawData[\"Ngày GDKHQ (Ex-right date)\"]),\n      record_date: formatDate(rawData[\"Ngày chốt (Closing date)\"]),\n      payment_date: formatDate(rawData[\"Ngày thực hiện (Excercise date)\"])\n    }\n  };\n});"
      },
