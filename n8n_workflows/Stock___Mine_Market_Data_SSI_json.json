    {
      "parameters": {
        "jsCode": "const inputData = $input.first().json;\nconst items = inputData.data;\n\n// Validate that the data property contains an array\nif (!Array.isArray(items)) {\n    return [];\n}\n\n// Map rows directly into the ClickHouse table schema\nreturn items.map(item => {\n    return {\n        json: {\n            symbol: String(item.stockSymbol || \"\"),\n            open: (parseFloat(item.openPrice) / 1000) || 0.0,\n            high: (parseFloat(item.highest) / 1000) || 0.0,\n            low: (parseFloat(item.lowest) / 1000) || 0.0,\n            close: (parseFloat(item.matchedPrice) / 1000) || 0.0,\n            adj_close: (parseFloat(item.matchedPrice) / 1000) || 0.0,\n            volume: parseInt(item.nmTotalTradedQty, 10) || 0,\n            trading_value: (parseFloat(item.nmTotalTradedValue) / 1000000) || 0.0\n        }\n    };\n});"
      },
