    {
      "parameters": {
        "jsCode": "// Extract text content from binary file property\nconst binaryPropertyName = 'file'; // Change to match your binary property name\n\nif (!items[0].binary || !items[0].binary[binaryPropertyName]) {\n  throw new Error(`Binary property \"${binaryPropertyName}\" not found in input.`);\n}\n\n// Convert base64 data to string\nconst base64Data = items[0].binary[binaryPropertyName].data;\nconst jsonText = Buffer.from(base64Data, 'base64').toString('utf-8');\n\n// Parse string to JSON object\nconst parsedData = JSON.parse(jsonText);\n\nreturn {\n  json: parsedData\n};"
      },
