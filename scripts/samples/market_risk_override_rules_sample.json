{
  "market_regime_rules": [
    {
      "regime_code": "REGIME_5",
      "priority": 1,
      "state": "Panic",
      "description": "The market experienced extreme oversold conditions, and signs of panic emerged",
      "condition": {
        "operator": "AND",
        "operands": [
          {
            "operator": "<",
            "operands": [
              { "field": "ratio_ad" },
              { "value": 0.2 }
            ]
          },
          {
            "operator": "<",
            "operands": [
              { "field": "ceiling" },
              { "value": 5 }
            ]
          },
          {
            "operator": ">=",
            "operands": [
              { "field": "floor" },
              { "value": 30 }
            ]
          }
        ]
      }
    },
    {
